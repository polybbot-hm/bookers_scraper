# ──────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copia a `.env` y rellena. NO subas `.env` al repo.
# ──────────────────────────────────────────────────────────────

# ─── Supabase (OBLIGATORIO para subir cuotas a Postgres) ──────
# NO uses la URL del proyecto (https://xxxxx.supabase.co).
# Usa la URI de Postgres: Project Settings → Database → Connection string → URI.
# Recomendado: "Transaction pooler" (puerto 6543) para Railway/cron.
# Si el panel no añade SSL, puedes añadir al final: ?sslmode=require
#
# Transaction pooler (IPv4, recomendado en Windows y en Railway):
#   user: postgres.TU_PROJECT_REF   (con punto; lo copias del panel "Connect")
#   host: aws-1-eu-west-1.pooler.supabase.com   (el prefijo aws-* y región vienen de TU panel)
#   port: 6543
#
# SUPABASE_DB_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:6543/postgres
# (El código añade ?sslmode=require si falta; puedes añadirlo tú al final.)
#
# Opción B (recomendada si la contraseña tiene $, @, :, etc.): variables separadas.
# Si rellenas estas tres, SUPABASE_DB_URL puede quedar vacío (tienen prioridad).
# SUPABASE_DB_USER=postgres.TU_PROJECT_REF
# SUPABASE_DB_PASSWORD=
# SUPABASE_DB_HOST=aws-1-eu-west-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
#
# IMPORTANTE — dos causas típicas de fallo:
# 1) Host "db.*.supabase.co" (puerto 5432) suele ser SOLO IPv6. No uses esa URI en
#    este proyecto; usa SIEMPRE el pooler (6543) que te da Supabase → Connect.
# 2) Si la contraseña tiene caracteres especiales (@ # $ % : etc.), codifícalos en la URI
#    ($ → %24, @ → %40) o pon la URI entre comillas simples. Los scripts del repo cargan
#    .env con interpolate=False para que un $ literal en la contraseña no se pierda.
SUPABASE_DB_URL=
SUPABASE_TABLE=odds_history

# ─── MongoDB (OPCIONAL — si no lo pones, se salta) ────────────
# Si rellenas MONGO_URI, los 4 scrapers escribirán en la misma colección con el
# esquema canónico. Para MongoDB Atlas:
# MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=
MONGO_DB=sports_odds
MONGO_COLLECTION=odds_history

# ─── Control de salidas y entorno ─────────────────────────────
# En Railway/Docker: 1 (no generar CSV/JSON en disco efímero).
# En local: déjalo a 0 para guardar CSV/JSON en data/.
DISABLE_FILE_OUTPUT=0

# Playwright: en contenedor HEADLESS=1 es obligatorio.
# En local puedes ponerlo a 0 para ver el navegador.
HEADLESS=0

# ─── Retabet ──────────────────────────────────────────────────
# 1 = abrir URL del evento, scroll y expandir mercados (más cuotas).
# 0 = sólo API LoadPageByUrl (más rápido, puede traer menos bloques en el HTML).
RETABET_DETAIL_VIA_PAGE=1
# 1 = clic en pestañas (Partido, Estadísticas Partido, Córners, …) y fusionar mercados (faltas, etc.).
RETABET_CLICK_MARKET_TABS=1
# Segundos de espera tras expandir/scroll antes de leer el HTML.
RETABET_DETAIL_EXTRA_WAIT=1.2
# Pausa tras cada clic de pestaña antes de volver a parsear.
RETABET_TAB_CLICK_DELAY=0.55
# Depuración faltas / DOM: guarda HTML de un partido y estadísticas en consola.
RETABET_DEBUG_SAVE_HTML=0
RETABET_DEBUG_EVENT_INDEX=1

# ─── Gran Casino (Altenar) ────────────────────────────────────
# 0 (default) = todos los mercados del feed (markets + childMarkets).
# 1 = modo antiguo: sólo typeIds objetivo + mercados cuyo nombre contiene palabras clave extra.
GRAN_FILTER_MARKETS=0

# ─── 22bet ────────────────────────────────────────────────────
# Pausas entre requests a la API LineFeed (pares match_ci + cada subgame).
TWENTYTWOBET_RATE_MIN=1.0
TWENTYTWOBET_RATE_MAX=2.0
# Deja vacío para todos los partidos; útil para smoke tests (`=3`).
TWENTYTWOBET_MAX_MATCHES=

# ─── Orquestación ─────────────────────────────────────────────
# Subconjunto de scrapers a ejecutar (separados por coma).
# Default: retabet,grancasino,kirolbet,twentytwobet
SCRAPERS=retabet,grancasino,kirolbet,twentytwobet
